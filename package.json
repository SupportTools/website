{
  "name": "support-tools-website",
  "version": "1.0.0",
  "type": "module",
  "description": "Support Tools website deployed on Cloudflare Workers",
  "main": "src/worker.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dev": "wrangler deploy --env development",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "build:hugo": "cd blog && hugo --minify --gc --cleanDestinationDir --baseURL https://support.tools",
    "build:search": "pagefind --site blog/public",
    "build": "npm run build:hugo && npm run build:search",
    "serve": "cd blog && hugo server -D --bind=0.0.0.0 --baseURL=http://localhost:1313",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:headings": "node scripts/check-headings.mjs",
    "check:categories": "node scripts/check-categories.mjs",
    "check:paths": "node scripts/check-duplicate-paths.mjs",
    "test:theme": "node tests/theme/build-fixtures.mjs && node --test tests/theme/*.test.mjs",
    "test:og": "node --test tests/og/*.test.mjs",
    "og": "node scripts/og/run.mjs"
  },
  "devDependencies": {
    "pagefind": "1.5.2",
    "wrangler": "4.151.1"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "cloudflare-workers",
    "static-site",
    "hugo",
    "blog"
  ],
  "author": "Support Tools",
  "license": "MIT"
}
